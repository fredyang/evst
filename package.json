{
  "name": "ngrx-sugar-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pack:all": "npm pack --workspaces",
    "build:ngrx-books": "ng build ngrx-books",
    "build:ngrx-books-standalone": "ng build ngrx-books-standalone",
    "build:books-svc": "ng build books-svc",
    "build:sugar-books": "ng build sugar-books",
    "test:ngrx-books": "vitest run --config examples/projects/ngrx-books/vitest.config.mts",
    "test:ngrx-books-standalone": "vitest run --config examples/projects/ngrx-books-standalone/vitest.config.mts",
    "test:books-svc": "vitest run --config examples/projects/books-svc/vitest.config.mts",
    "test:sugar-books": "vitest run --config examples/projects/sugar-books/vitest.config.mts",
    "serve:ngrx-books": "ng serve ngrx-books --port 4200",
    "serve:ngrx-books-standalone": "ng serve ngrx-books-standalone --port 4202",
    "serve:books-svc": "ng serve books-svc --port 4203",
    "serve:sugar-books": "ng serve sugar-books --port 4201",
    "serve:examples": "concurrently \"npm run serve:ngrx-books\" \"npm run serve:sugar-books\" \"npm run serve:ngrx-books-standalone\" \"npm run serve:books-svc\"",
    "lint:sugar-books": "npm run build --workspace @ngrx-sugar/eslint && cd examples/projects/sugar-books && eslint \"src/**/*.ts\"",
    "lint:ngrx-books-standalone": "npm run build --workspace @ngrx-sugar/eslint && cd examples/projects/ngrx-books-standalone && eslint \"src/**/*.ts\"",
    "lint:books-svc": "npm run build --workspace @ngrx-sugar/eslint && cd examples/projects/books-svc && eslint \"src/**/*.ts\"",
    "lint:publisher-ownership": "npm run build --workspace @ngrx-sugar/eslint && cd examples/projects/sugar-books && eslint \"src/**/*.ts\" --rule \"ngrx-sugar/no-unused-views: off\"",
    "watch:publisher-ownership": "npm run build --workspace @ngrx-sugar/eslint && node .vscode/watch-publisher-ownership.cjs"
  },
  "lint-staged": {
    "*.{cjs,js,json,md,mjs,ts}": "prettier --write"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular/animations": "22.1.3",
    "@angular/build": "22.1.6",
    "@angular/cdk": "22.1.3",
    "@angular/cli": "^22.1.6",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/operators": "22.0.1",
    "@ngrx/router-store": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@types/node": "^24.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.34.0",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "rxjs": "7.8.0",
    "tslib": "^2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.8",
    "zone.js": "0.15.0"
  }
}
