{
  "name": "evst-workspace",
  "private": true,
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "docs:api": "npm run docs:api --workspace @evst/ngrx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pack:all": "npm pack --workspaces",
    "version:all": "node scripts/version-all.cjs",
    "publish:all": "npm publish --workspace @evst/ngrx --access public && npm publish --workspace @evst/eslint-plugin --access public",
    "build:ngrx-books": "ng build ngrx-books",
    "build:ngrx-books-standalone": "ng build ngrx-books-standalone",
    "build:svc-books": "ng build svc-books",
    "build:evst-ngrx-books": "ng build evst-ngrx-books",
    "build:evst-rtk-books": "tsc --noEmit -p examples/projects/evst-rtk-books/tsconfig.json && vite build --config examples/projects/evst-rtk-books/vite.config.ts",
    "test:evst-rtk-books": "vitest run --config examples/projects/evst-rtk-books/vitest.config.ts",
    "build:rtk-books": "tsc --noEmit -p examples/projects/rtk-books/tsconfig.json && vite build --config examples/projects/rtk-books/vite.config.ts",
    "test:rtk-books": "vitest run --config examples/projects/rtk-books/vitest.config.ts",
    "test:ngrx-books": "vitest run --config examples/projects/ngrx-books/vitest.config.mts",
    "test:ngrx-books-standalone": "vitest run --config examples/projects/ngrx-books-standalone/vitest.config.mts",
    "test:evst-ngrx-books": "vitest run --config examples/projects/evst-ngrx-books/vitest.config.mts",
    "serve:ngrx-books": "ng serve ngrx-books --port 4200",
    "serve:ngrx-books-standalone": "ng serve ngrx-books-standalone --port 4201",
    "serve:evst-ngrx-books": "ng serve evst-ngrx-books --port 4202",
    "serve:evst-rtk-books": "vite --config examples/projects/evst-rtk-books/vite.config.ts --port 4204",
    "serve:rtk-books": "vite --config examples/projects/rtk-books/vite.config.ts --port 4205",
    "serve:svc-books": "ng serve svc-books --port 4203",
    "serve:examples": "concurrently \"npm run serve:ngrx-books\" \"npm run serve:evst-ngrx-books\" \"npm run serve:ngrx-books-standalone\" \"npm run serve:svc-books\"",
    "lint:evst-ngrx-books": "npm run build --workspace @evst/eslint-plugin && cd examples/projects/evst-ngrx-books && eslint \"src/**/*.ts\"",
    "lint:ngrx-books-standalone": "npm run build --workspace @evst/eslint-plugin && cd examples/projects/ngrx-books-standalone && eslint \"src/**/*.ts\"",
    "lint:svc-books": "cd examples/projects/svc-books && eslint \"src/**/*.ts\"",
    "lint:publisher-ownership": "npm run build --workspace @evst/eslint-plugin && cd examples/projects/evst-ngrx-books && eslint \"src/**/*.ts\" --rule \"evst/no-unused-views: off\"",
    "watch:publisher-ownership": "npm run build --workspace @evst/eslint-plugin && node .vscode/watch-publisher-ownership.cjs"
  },
  "lint-staged": {
    "*.{cjs,js,json,md,mjs,ts}": "prettier --write"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular/animations": "22.1.3",
    "@angular/build": "22.1.6",
    "@angular/cdk": "22.1.3",
    "@angular/cli": "^22.1.6",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/operators": "22.0.1",
    "@ngrx/router-store": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@types/node": "^24.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.34.0",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "rxjs": "7.8.0",
    "tslib": "^2.7.0",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.8",
    "zone.js": "0.15.0"
  },
  "version": "0.1.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
