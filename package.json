{
  "name": "evst-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "docs:api": "npm run docs:api --workspace @evst/store",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pack:all": "npm pack --workspaces",
    "build:ngrx-books": "ng build ngrx-books",
    "build:ngrx-books-standalone": "ng build ngrx-books-standalone",
    "build:svc-books": "ng build svc-books",
    "build:evst-books": "ng build evst-books",
    "test:ngrx-books": "vitest run --config examples/projects/ngrx-books/vitest.config.mts",
    "test:ngrx-books-standalone": "vitest run --config examples/projects/ngrx-books-standalone/vitest.config.mts",
    "test:evst-books": "vitest run --config examples/projects/evst-books/vitest.config.mts",
    "serve:ngrx-books": "ng serve ngrx-books --port 4200",
    "serve:ngrx-books-standalone": "ng serve ngrx-books-standalone --port 4201",
    "serve:evst-books": "ng serve evst-books --port 4202",
    "serve:svc-books": "ng serve svc-books --port 4203",
    "serve:examples": "concurrently \"npm run serve:ngrx-books\" \"npm run serve:evst-books\" \"npm run serve:ngrx-books-standalone\" \"npm run serve:svc-books\"",
    "lint:evst-books": "npm run build --workspace @evst/eslint-plugin && cd examples/projects/evst-books && eslint \"src/**/*.ts\"",
    "lint:ngrx-books-standalone": "npm run build --workspace @evst/eslint-plugin && cd examples/projects/ngrx-books-standalone && eslint \"src/**/*.ts\"",
    "lint:svc-books": "cd examples/projects/svc-books && eslint \"src/**/*.ts\"",
    "lint:publisher-ownership": "npm run build --workspace @evst/eslint-plugin && cd examples/projects/evst-books && eslint \"src/**/*.ts\" --rule \"evst/no-unused-views: off\"",
    "watch:publisher-ownership": "npm run build --workspace @evst/eslint-plugin && node .vscode/watch-publisher-ownership.cjs"
  },
  "lint-staged": {
    "*.{cjs,js,json,md,mjs,ts}": "prettier --write"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular/animations": "22.1.3",
    "@angular/build": "22.1.6",
    "@angular/cdk": "22.1.3",
    "@angular/cli": "^22.1.6",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/operators": "22.0.1",
    "@ngrx/router-store": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@types/node": "^24.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.34.0",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "rxjs": "7.8.0",
    "tslib": "^2.7.0",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.8",
    "zone.js": "0.15.0"
  },
  "version": "0.1.0"
}
